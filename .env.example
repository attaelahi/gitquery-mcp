# ==============================================================================
# gitquery-mcp Environment Configuration
# ==============================================================================

# GitHub Personal Access Token (classic or fine-grained).
# For public repositories, this token is optional but strongly recommended to avoid
# unauthenticated 60 req/hr rate limits. For private repositories, read access is required.
# Scopes: For fine-grained tokens, only "Contents: Read-only" and "Pull requests: Read-only" are needed.
GITHUB_TOKEN=

# Restrict queries to specific repositories (comma-separated).
# Wildcard syntax is supported: "owner/repo" or "owner/*" (case-insensitive).
# When unset or empty, any accessible repository can be queried.
# Example: ALLOWED_REPOS=facebook/react,vercel/*
ALLOWED_REPOS=

# Directory for optional on-disk persistent cache.
# When specified, immutable SHA-addressed query results (blame, diffs, history)
# are persisted across server restarts. Mutable branch/tag ref resolutions are never cached to disk.
# Example: GITQUERY_CACHE_DIR=.gitquery-cache
GITQUERY_CACHE_DIR=

# Maximum disk cache storage in bytes (default: 209715200 = 200 MB).
# Oldest accessed entries are automatically evicted when total size exceeds this threshold.
GITQUERY_CACHE_MAX_BYTES=209715200

# In-memory LRU cache capacity (max entries, default: 5000).
CACHE_SIZE=5000

# In-memory cache TTL for mutable branch/tag -> SHA resolutions in seconds (default: 30).
CACHE_TTL_MUTABLE_SECONDS=30

# Stderr logging verbosity: "debug", "info", "warn", or "error" (default: "info").
LOG_LEVEL=info
